%-- type declarations, function types --%
type BinaryOperator = \<N narrows int>(a: N, b?: N) => N;
type BinaryOperator = \<N narrows int>(a: N, b?: N) => NAMESPACE::N;
type BinaryOperator = \<out N>(a: N, b?: N) => N;
type BinaryOperator = \<in N>(a: N, b?: N) => N;
type BinaryOperator = \(a: N, b?: N) => N | M;
type BinaryOperatorUnnamed = \(T & U?, ?: int | Object~~, ?: bool) => \(float) => int;
type BinaryOperatorUnnamed = \(?: int | Object, ?: (T, U), ?: \(bool!) => void) => float;
type BinaryOperator = \<
	N narrows int~~,
>(
	'a': N,
	b?:  N,
	c%%c%%: N,
) %%c%% => N;
type BinaryOperator = \(
	'a': N,
	b?:  N,
	c%%c%%: N,
) %%c%% => N;
type Const = \() => int;
type Const = \(
) => int;
type ReturnsTemplateType = \() => """a {{ string }} template type""";
val x: \<out T widens U~~, in U? = Set.<null>>(a: Set.<T>~~, b: Set.<U~~>) => bool = null;


%-- function expression statements --%
\(mut h: int): int => h + 1;
\(%%mut%% h: int): int => h + 1;
\(%%mut%% h: int): NAMESPACE::Int => h + 1;
% return type with set/map shorthand syntax
\(): ({int}) {
	return {42, 69};
};
\(): ({int}) => {42, 69};
\(): ({int -> int}) {
	return {42 -> 69};
};
\(): ({int -> int}) => {42 -> 69};
% implicitly returning a block-expression
\(): int => { 42; };



%-- variable declarations, function expressions --%
val x: \(a: str) => str = \(a: str): str => """<x>{{ a }}</x>""";
val x: \(a: str) => str = \(a: str): str {
	func y(): void {;}
	val x: str = "x";
	return """<{{ x }}>{{ a }}</{{ x }}>""";
};
val y: \() => NS::V = \(): NS::V {;};
val y: \() => NS::N = \(): NS::N => null;
% return type with set/map shorthand syntax
val return_set_of_int = \(): ({int}) {
	return {42, 69};
};
val return_set_of_int = \(): ({int}) => {42, 69};
val return_map_of_int = \(): ({int -> int}) {
	return {42 -> 69};
};
val return_map_of_int = \(): ({int -> int}) => {42 -> 69};
% implicitly returning a block-expression
val return_block_expr = \(): int => { 42; };

val lambda: Function = \(            )      { return a * 2; };
val lambda: Function = \(a           )      { return a * 2; };
val lambda: Function = \(a: int      ): int { return a * 2; };
val lambda: Function = \(a?      = 42): int { return a * 2; };
val lambda: Function = \(a?: int = 42): int { return a * 2; };
val lambda: Function = \(            )      => a * 2;
val lambda: Function = \(a           )      => a * 2;
val lambda: Function = \(a: int      ): int => a * 2;
val lambda: Function = \(a?      = 42): int => a * 2;
val lambda: Function = \(a?: int = 42): int => a * 2;
val lambda: Function = \<T               >() {};
val lambda: Function = \<out T           >() {};
val lambda: Function = \<in  T           >() {};
val lambda: Function = \<T narrows U     >() {};
val lambda: Function = \<T?           = V>() {};
val lambda: Function = \<T? narrows U = V>() {};
val not_lambda: NotFunction = a < b > (c);
val not_lambda: NotFunction = a.<b>(c);

val lambda: Function = \(
	a,
	a: int,
	a?      = 42,
	a?: int = 42,
	mut b,
) { return a * 2; };
val lambda: Function = \(
	a,
	a: int,
	a?      = 42,
	a?: int = 42,
	mut b,
) => a * 2;
val lambda: Function = \<
	T,
	out T,
	in  T,
	mut out T,
	mut in  T,
	T narrows U,
	T? = V,
	T? narrows U = V,
>() {};

val nestedfunctions: \(a: \(x: int) %%c%% => %%c%% int) %%c%% => %%c%% bool
	= \(a?: \(x: int) %%c%% => %%c%% int = \(x) %%c%% => %%c%% x * 2) %%c%% => %%c%% !!a;

val lambdawithblockcomments: Function = \<T, U>%%hello%%(a: T, b: U): Object %%world%% => a || b;
val lambdawithblockcomments: Function = \<T, U>%%hello%%(a: T, b: U) %%world%% => a || b;
val lambdawithlinecomments:  Function = \<T, U> % hello
	(a: T, b: U): Object % world
	=> a || b;
val lambdawithlinecomments: Function = \<T, U> % hello
	(a: T, b: U) % world
	=> a || b;

val lambdaWithCaptures: Function = \(x) with (a, b ,) => a + b + x;
val lambdaWithCaptures: Function = \<T>(x) with (a, b ,) => a + b + x;
val lambdaWithCaptures: Function = \<T, U>(x) with (a, b ,) => a + b + x;
val lambdaWithGeneric:  Function = \<T>(x) => a + b + x;
val lambdaWithCaptures: Function = \(x) with (
	a,
	'b',
) => a + b + x;
val tuple: (Function,) = (\(x) with (a, ref b) => a + b + x,);
val record: (lambdaWithCaptures: Function) = (lambdaWithCaptures= \(x) with (a, ref b) => a + b + x);
val list: [Function]  = [\(x) with (a, ref b) => a + b + x];
val dict: [:Function] = [lambdaWithCaptures= \(x) with (a, ref b) => a + b + x];



%-- function declarations --%
func 'func'(param?: annot = initial): void {;}
func 'func'(param?: annot): void {;}
func _(): void {;}
func y(): NAMESPACE::Void {;}
func y(): NAMESPACE::Null => null;
func <_, B>(): B {;}
func (_: A, b: B): B {;}

func add(a?: int = 0, b?: int = 0): int { return a + b; }
func subtract(mut a?: int = 0, %%mut%% b?: int = a): int => a - b;
func %%comm%% do_nothing(): void {
	val x: anything = 0;
	return;
}
func error(): nothing {
	throw if true then "error" else "an error";
	throw (if true then "error" else "an error");
}
func parameterAlias(p %%c%% = %%c%% q: anything): null => null;
func parameterNoAlias(q: anything): null => null;

func append<T widens bool>(arr?: Array.<T> = [], it: T): void {
	arr.push.<T>(it)~;
}
func derivative<T narrows float>(lambda: \(y: T) => T, delta: T): \(x: T) => T {
	return \(x: T): T => (lambda.(x + delta)~ - lambda.(x)~) / delta;
}
func subset<T? = Set.<null>, U widens T>(a: Set.<T>, b: Set.<U>): bool {;}

func functionWithCaptures(x: int): int with (a, ref b) => a + b + x;
func functionWithCaptures[
	a,
	ref 'b',
](x: int): int => a + b + x;

func returnFunc(): Object => \(x: int): int => x + 1;
func returnFunc(): (Object) => \(x: int): int => x + 1;
func returnFunc(): ({Object}) => \(x: int): int => x + 1;
func returnFunc(): Object => \(x: int): ({int}) => x + 1;
func returnFunc(): \(x: int) => int => \(x) => x + 1;

func returnFunc(): \(A) => (B) => \(a) => b;
func returnInstance(): interface {
	x: int;
	y(): int;
	z(): \(str) => int;
} => (class {
	public x: int = 0;
	public y(): int => 0;
	public y(): (int) => 0;
	public z(): \(str) => int => \(s: str) => s.length;
}).();
% return type with set/map shorthand syntax
func return_set_of_int(): ({int}) {
	return {42, 69};
};
func return_set_of_int(): ({int}) => {42, 69};
func return_map_of_int(): ({int -> int}) {
	return {42 -> 69};
};
func return_map_of_int(): ({int -> int}) => {42 -> 69};
% implicitly returning a block-expression
func return_block_expr(): int => { 42; };

func add<T>(x, y) impl BinaryOperator.<T> {
	return x + y;
}
func add<T>(x, y) impl BinaryOperator.<T> => x + y;
func addCaptures<T>(x, y) impl BinaryOperator.<T> with (z) {
	return x + y + z;
}
func addCaptures<T>(x, y) impl BinaryOperator.<T> with (z) => x + y + z;

public func subtract(a: N, b: N): N { return a - b; }
internal func subtract(a: N, b: N): N => a - b;
private func subtract(a: N, b: N): N => a - b;




func add(a? = x):    int => a + b;
func add(a= x?):     int => a + b;
func add(a= x? = 0): int => a + b;
%-- punning in function params --%
func subtract(a= mut a?:  int = 0, b= %%mut%% b?:  int = a): int => a - b;
func subtract(   mut $a?: int = 0,    %%mut%% $b?: int = a): int => a - b;
func subtract(   mut $a: int,         %%mut%% $b: int):      int => a - b;
func subtract(   mut $a?      = 0,    %%mut%% $b?      = a): int => a - b;
func subtract(   mut $a,              %%mut%% $b):           int => a - b;
val subtract: Function = \(a= mut a?:  int = 0, b= %%mut%% b?:  int = a): int => a - b;
val subtract: Function = \(   mut $a?: int = 0,    %%mut%% $b?: int = a): int => a - b;
val subtract: Function = \(   mut $a: int,         %%mut%% $b: int):      int => a - b;
val subtract: Function = \(   mut $a?      = 0,    %%mut%% $b?      = a): int => a - b;
val subtract: Function = \(   mut $a,              %%mut%% $b):           int => a - b;


%-- punning in generic typefunc params --%
typefunc Binop<A= nominal out A?  narrows int = int, B= %%nominal%% mut in B?  widens int = A> => int;
typefunc Binop<   nominal out $A? narrows int = int,    %%nominal%% mut in $B? widens int = A> => int;
